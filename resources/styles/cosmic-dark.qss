/* Nebula — static dark stylesheet ("Nebula Dark", Dia-inspired calm chrome).
 *
 * Temporary by design: the Theme Engine (Phase 3) replaces this file with
 * per-theme resources. Colors here are the "Nebula Dark" baseline.
 * No global font-size: system font and scaling stay in control (§52).
 *
 * Palette: deep neutral charcoal surfaces, hairline borders, one violet
 * accent (@ACCENT@), pill-shaped controls, floating rounded tabs.
 * Tab text colors (current/ungrouped/grouped) are set per-tab in code —
 * QSS deliberately carries no QTabBar::tab color rule.
 */

/* --- tokens / global ---------------------------------------------------- */
QMainWindow {
    background: #111319;
}

QDialog {
    background: #1a1d25;
}

QWidget {
    color: #e8e9ee;
}

QLabel {
    color: #c3c8d2;
    background: transparent;
}

QToolTip {
    background: #23262f;
    color: #e8e9ee;
    border: 1px solid #333845;
    padding: 5px 9px;
    border-radius: 6px;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
}

/* --- toolbar ------------------------------------------------------------ */
QToolBar {
    background: #151820;
    border: none;
    border-bottom: 1px solid #252a35;
    spacing: 8px;
    padding: 6px 12px;
}

QToolBar#navToolbar {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #171b24, stop: 0.5 #151820,
                                stop: 1 #171b24);
    border-bottom: 1px solid #2a303b;
}

QToolBar#navToolbar QToolButton[toolbarIcon="true"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    padding: 0;
}

QToolBar#navToolbar QToolButton[toolbarIcon="true"]:hover {
    background: #252b36;
    border-color: #343d4b;
}

QToolBar#navToolbar QToolButton[toolbarIcon="true"]:pressed {
    background: #2b3040;
    border-color: #45405f;
}

QToolBar#navToolbar QToolButton[toolbarIcon="true"]:checked {
    background: #292541;
    border-color: #4b426f;
}

QToolBar#navToolbar QToolButton[toolbarIcon="true"]:focus {
    border-color: @ACCENT@;
}

QToolBar#navToolbar QToolButton[toolbarIcon="true"]:disabled {
    background: transparent;
    border-color: transparent;
}

QToolBar#navToolbar QToolButton#userButton[toolbarIdentity="true"] {
    background: #1d222c;
    border: 1px solid #303846;
    border-radius: 13px;
    color: #e6e9ef;
    padding: 5px 11px;
}

QToolBar#navToolbar QToolButton#userButton[toolbarIdentity="true"]:hover {
    background: #262d39;
    border-color: #465166;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 7px;
    color: #c9cdd6;
}

QToolButton:hover {
    background: #24272f;
    color: #ffffff;
}

QToolButton:pressed {
    background: #20232b;
}

QToolButton:disabled {
    color: #5c616d;
}

QToolButton::menu-indicator {
    image: none;
}

/* --- address bar -------------------------------------------------------- */
QLineEdit#urlBar {
    background: #20242d;
    border: 1px solid #343b48;
    border-radius: 18px;
    padding: 5px 34px;
    font-size: 13px;
    min-height: 34px;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
}

QLineEdit#urlBar:hover {
    border-color: #444c5b;
}

QLineEdit#urlBar:focus {
    border-color: @ACCENT@;
    background: #252a34;
}

QLineEdit#urlBar QToolButton {
    border-radius: 12px;
    padding: 3px;
}

/* --- container (context) button ----------------------------------------- */
QToolButton#contextButton {
    background: #1b1d24;
    border: 1px solid #2a2e39;
    border-radius: 14px;
    padding: 4px 10px;
    color: #cfd2da;
}

QToolButton#contextButton:hover {
    background: #24272f;
    border-color: #363b49;
    color: #ffffff;
}

QToolButton#contextButton::menu-indicator {
    image: url(:/icons/arrow-down.svg);
    width: 9px;
    height: 6px;
    subcontrol-position: center right;
    subcontrol-origin: padding;
    padding-right: 0px;
}

/* --- tab widget --------------------------------------------------------- */
QTabWidget#tabWidget {
    background: #151820;
}

QTabWidget#tabWidget::pane {
    border: none;
    background: #111319;
}

QTabBar {
    background: transparent;
}

QTabBar#browserTabBar[verticalTabs="true"] {
    background: #151a23;
}

QTabBar#browserTabBar[verticalTabs="true"]::tab {
    margin: 3px 0;
    min-width: 180px;
    max-width: 420px;
    padding: 0 8px;
}

QTabBar#browserTabBar[verticalTabs="true"] QAbstractButton#tabCloseButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 3px;
}

QTabBar#browserTabBar[verticalTabs="true"] QAbstractButton#tabCloseButton:hover {
    background: #3a3038;
}

QTabBar::tab {
    background: transparent;
    border: 1px solid transparent;
    padding: 7px 13px;
    margin: 4px 3px 4px 0;
    border-radius: 9px;
}

QTabBar#browserTabBar[verticalTabs="false"]::tab {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #202633, stop: 1 #191e29);
    border: 1px solid #2d3543;
    border-radius: 12px;
    color: #b6becc;
    max-width: 250px;
    min-height: 34px;
    padding: 5px 14px;
    margin: 5px 4px 5px 0;
}

QTabBar#browserTabBar[verticalTabs="false"]::tab:selected {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #302c47, stop: 1 #242238);
    border-color: #514978;
    color: #ffffff;
}

QTabBar#browserTabBar[verticalTabs="false"]::tab:hover:!selected {
    background: #272d39;
    border-color: #404a5a;
    color: #f0f2f7;
}

QTabBar::tab:selected {
    background: #222731;
    border: 1px solid #343b48;
}

QTabBar::tab:hover:!selected {
    background: #1b1f27;
}

QTabBar::close-button {
    subcontrol-position: right center;
    subcontrol-origin: padding;
    image: url(:/icons/close.svg);
    width: 16px;
    height: 16px;
    border-radius: 7px;
    margin-right: 2px;
}

QTabBar::close-button:hover {
    image: url(:/icons/close-active.svg);
    background: #333845;
}

/* --- status bar / progress ---------------------------------------------- */
QStatusBar {
    background: #151820;
    border-top: 1px solid #252a35;
    color: #8b909c;
}

QStatusBar::item {
    border: none;
}

QProgressBar#loadProgress {
    background: transparent;
    border: none;
    max-height: 3px;
    min-height: 3px;
    text-align: center;
}

QProgressBar#loadProgress::chunk {
    background: @ACCENT@;
    border: none;
    border-radius: 1px;
}

/* --- New Tab page ------------------------------------------------------- */
QLabel#ntpClock {
    color: #f4f5f8;
    font-size: 42px;
    font-weight: 650;
}

QLabel#ntpDate {
    color: #929baa;
    font-size: 13px;
    padding-bottom: 2px;
}

QLabel#ntpCaption {
    color: #f0f2f7;
    font-size: 25px;
    font-weight: 700;
    padding-top: 2px;
}

QLabel#ntpSubtitle {
    color: #929baa;
    font-size: 13px;
    padding-bottom: 5px;
}

QLabel#ntpHint, QLabel#ntpEmptyBookmarks {
    color: #7d8290;
    font-size: 12px;
}

QLabel#ntpBookmarksTitle {
    color: #f0f2f8;
    font-size: 16px;
    font-weight: 700;
    padding: 0 2px 2px;
}

QWidget#ntpBookmarksSection {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 rgba(26, 31, 45, 225),
                                stop: 0.55 rgba(19, 24, 35, 218),
                                stop: 1 rgba(18, 27, 38, 225));
    border: 1px solid rgba(151, 143, 213, 54);
    border-radius: 22px;
}

QWidget#ntpBookmarksContent {
    background: transparent;
}

QScrollArea#ntpBookmarksScroll,
QScrollArea#ntpBookmarksScroll > QWidget,
QScrollArea#ntpBookmarksScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QToolButton#ntpBookmark {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #222838, stop: 1 #1b202c);
    border: 1px solid #343d50;
    border-radius: 15px;
    color: #e0e4eb;
    padding: 9px 14px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}

QToolButton#ntpBookmark:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #2b3042, stop: 1 #222938);
    border-color: @ACCENT_HI@;
    color: #ffffff;
}

QToolButton#ntpBookmark:pressed {
    background: #25283a;
}

QLineEdit#ntpSearch {
    background: rgba(26, 31, 43, 242);
    border: 1px solid #41495c;
    border-radius: 29px;
    padding: 16px 24px;
    font-size: 16px;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
}

QLineEdit#ntpSearch:hover {
    border-color: #444c5b;
}

QLineEdit#ntpSearch:focus {
    border-color: @ACCENT@;
    background: #252a34;
}

QLineEdit#ntpSearch QToolButton {
    border-radius: 14px;
    padding: 4px;
}

QLabel#ntpPrivacyBadge {
    border-radius: 14px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#ntpPrivacyBadge[protectionActive="true"] {
    color: #b7f2d0;
    background: #183728;
    border: 1px solid #28543d;
}

QLabel#ntpPrivacyBadge[protectionActive="false"] {
    color: #f1d59d;
    background: #352b19;
    border: 1px solid #5a4522;
}

/* --- crash page --------------------------------------------------------- */
QWidget#crashPage {
    background: #0f1013;
}

QLabel#crashTitle {
    color: #e8e9ee;
    font-size: 20px;
    font-weight: 600;
}

QLabel#crashHint {
    color: #7d8290;
    font-size: 13px;
    padding-top: 6px;
}

QPushButton#crashReload {
    background: @ACCENT@;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 10px 26px;
    font-weight: 600;
}

QPushButton#crashReload:hover {
    background: @ACCENT_HI@;
}

QPushButton#crashReload:pressed {
    background: @ACCENT_LO@;
}

/* --- group strip (tab groups) ------------------------------------------- */
QWidget#groupStrip {
    background: #14171e;
    border-bottom: 1px solid #252a35;
}

QToolButton#groupChip {
    background: transparent;
    border: 1px solid #2e3341;
    border-left: 3px solid @ACCENT@;
    border-radius: 11px;
    padding: 4px 12px;
    color: #e8e9ee;
    font-size: 12px;
}

QToolButton#groupChip:hover {
    background: #22252e;
}

QToolButton#groupChip:checked {
    background: #24272f;
    border-color: #3a3f4d;
}

/* --- name/color dialog (groups & containers) ---------------------------- */
QLineEdit#nameEdit {
    background: #1e2029;
    border: 1px solid #2e3341;
    border-radius: 8px;
    padding: 8px 12px;
    color: #e8e9ee;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
}

QLineEdit#nameEdit:focus {
    border-color: @ACCENT@;
}

/* --- menus -------------------------------------------------------------- */
QMenu {
    background: #1b1d24;
    border: 1px solid #2a2e39;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 7px 26px 7px 12px;
    margin: 1px 2px;
    color: #d5d8e0;
}

QMenu::item:selected {
    background: #2a2648;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #7f8593;
}

QMenu::separator {
    height: 1px;
    background: #262a33;
    margin: 5px 9px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3a4050;
    border-radius: 7px;
    background: #1e2029;
}

QMenu::indicator:hover {
    border-color: #4a5164;
}

QMenu::indicator:checked {
    background: @ACCENT@;
    border-color: @ACCENT@;
    image: url(:/icons/check.svg);
}

/* --- generic form controls (dialogs / settings) ------------------------- */
QComboBox {
    background: #1b1d24;
    border: 1px solid #2a2e39;
    border-radius: 8px;
    padding: 6px 30px 6px 11px;
    min-height: 18px;
    color: #e8e9ee;
}

QComboBox:hover {
    border-color: #363b49;
}

QComboBox:on {
    border-color: @ACCENT@;
    background: #1e2029;
}

QComboBox:disabled {
    background: #1d1f27;
    color: #5c616d;
    border-color: #24272f;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/arrow-down.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background: #1b1d24;
    border: 1px solid #2a2e39;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #2a2648;
    selection-color: #ffffff;
}

QLineEdit {
    background: #1b1d24;
    border: 1px solid #2a2e39;
    border-radius: 8px;
    padding: 6px 10px;
    color: #e8e9ee;
}

QLineEdit:hover {
    border-color: #363b49;
}

QLineEdit:focus {
    border-color: @ACCENT@;
}

QLineEdit:disabled {
    background: #171920;
    color: #5c616d;
    border-color: #22252d;
}

QCheckBox {
    spacing: 9px;
    color: #d5d8e0;
    background: transparent;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 1.5px solid #3a4050;
    border-radius: 5px;
    background: #1b1d24;
}

QCheckBox::indicator:hover {
    border-color: #4a5164;
}

QCheckBox::indicator:checked {
    background: @ACCENT@;
    border-color: @ACCENT@;
    image: url(:/icons/check.svg);
}

QCheckBox::indicator:disabled {
    background: #23262f;
    border-color: #2c3140;
}

QCheckBox:disabled {
    color: #5c616d;
}

QListWidget {
    background: #15171d;
    border: 1px solid #262a33;
    border-radius: 9px;
    padding: 4px;
    color: #e8e9ee;
}

QListWidget::item {
    border-radius: 6px;
    padding: 7px 9px;
    margin: 1px;
}

QListWidget::item:hover {
    background: #1e212a;
}

QListWidget::item:selected {
    background: #2a2648;
    color: #ffffff;
}

QTreeWidget {
    background: #15171d;
    border: 1px solid #262a33;
    border-radius: 9px;
    padding: 4px;
    color: #e8e9ee;
}

QTreeWidget::item {
    border-radius: 6px;
    padding: 5px 7px;
    margin: 1px;
}

QTreeWidget::item:hover {
    background: #1e212a;
}

QTreeWidget::item:selected {
    background: #2a2648;
    color: #ffffff;
}

QTreeWidget::item:!enabled {
    color: #5c616d;
}

QPushButton {
    background: #23262f;
    border: 1px solid #2e3341;
    border-radius: 8px;
    padding: 7px 17px;
    color: #e8e9ee;
}

QPushButton:hover {
    background: #2a2e3a;
    border-color: #3a4050;
}

QPushButton:pressed {
    background: #20232b;
}

QPushButton:disabled {
    background: #1d1f27;
    color: #5c616d;
    border-color: #24272f;
}

QPushButton:default {
    background: @ACCENT@;
    border: 1px solid @ACCENT@;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:default:hover {
    background: @ACCENT_HI@;
    border-color: @ACCENT_HI@;
}

QPushButton:default:pressed {
    background: @ACCENT_LO@;
    border-color: @ACCENT_LO@;
}

/* --- settings dialog ---------------------------------------------------- */
QWidget#settingsForm {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #151827, stop: 0.48 #10141c,
                                stop: 1 #141923);
}

/* --- first-run welcome -------------------------------------------------- */
QDialog#welcomeDialog {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #1b2030, stop: 0.48 #11151e,
                                stop: 1 #17212b);
}

QLabel#welcomeBrand {
    color: #c9c1ff;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 2px;
}

QLabel#welcomeStep {
    color: #a7b0bf;
    font-size: 12px;
    font-weight: 650;
}

QProgressBar#welcomeProgress {
    background: #252b38;
    border: none;
    border-radius: 3px;
    max-height: 5px;
}

QProgressBar#welcomeProgress::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 @ACCENT@, stop: 1 #55c5d8);
    border-radius: 3px;
}

QStackedWidget#welcomePages,
QWidget#welcomePages > QWidget {
    background: transparent;
}

QLabel#welcomeTitle {
    color: #f4f5fa;
    font-size: 28px;
    font-weight: 720;
    padding-top: 8px;
}

QLabel#welcomeDescription {
    color: #a4afbf;
    font-size: 14px;
    padding-bottom: 8px;
}

QWidget#welcomeFeatureCard,
QWidget#welcomeCard,
QWidget#welcomeFinishCard {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 rgba(38, 45, 62, 238),
                                stop: 1 rgba(27, 34, 47, 238));
    border: 1px solid #3a4355;
    border-radius: 18px;
}

QWidget#welcomeFeatureCard {
    min-width: 150px;
}

QWidget#welcomeFinishCard {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 rgba(50, 45, 79, 245),
                                stop: 1 rgba(28, 43, 55, 245));
    border-color: #5a5680;
}

QLabel#welcomeSectionTitle,
QLabel#welcomeFinishTitle {
    color: #eef0f7;
    font-size: 15px;
    font-weight: 680;
}

QLabel#welcomeHint,
QLabel#welcomeImportStatus {
    color: #a4afbf;
    font-size: 12px;
}

QLabel#welcomeImportStatus {
    padding: 6px 2px;
}

QLabel#welcomeError {
    color: #ffd2cf;
    background: #442b31;
    border: 1px solid #75424c;
    border-radius: 10px;
    padding: 9px 12px;
}

QPushButton#welcomeNextButton {
    min-width: 124px;
    min-height: 38px;
    border-radius: 12px;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 @ACCENT_HI@, stop: 1 @ACCENT@);
    border: 1px solid @ACCENT_HI@;
    color: #ffffff;
    font-weight: 680;
}

QPushButton#welcomeBackButton,
QPushButton#welcomeSkipButton,
QPushButton#welcomeImportButton {
    min-height: 36px;
    border-radius: 11px;
}

QPushButton#welcomeSkipButton {
    background: transparent;
    border-color: transparent;
    color: #a4afbf;
}

QPushButton#welcomeSkipButton:hover {
    background: #252b38;
    color: #ffffff;
}

QTabWidget#settingsTabs {
    background: transparent;
}

QTabWidget#settingsTabs::pane {
    border: 1px solid #303747;
    border-radius: 18px;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #1b2030, stop: 0.5 #151a25,
                                stop: 1 #141922);
    top: -1px;
}

QTabWidget#settingsTabs QTabBar {
    background: transparent;
    padding: 12px 14px 14px;
}

QTabWidget#settingsTabs QTabBar::tab {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #202534, stop: 1 #1a1f2b);
    border: 1px solid #303747;
    border-radius: 13px;
    color: #b7c0cf;
    margin: 0 6px 0 0;
    min-height: 36px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
}

QTabWidget#settingsTabs QTabBar::tab:selected {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #393255, stop: 1 #28243e);
    border-color: #7164a6;
    color: #ffffff;
}

QTabWidget#settingsTabs QTabBar::tab:hover:!selected {
    background: #282e3c;
    border-color: #475268;
    color: #e8ebf1;
}

QWidget#settingsTabGeneral,
QWidget#settingsTabSearch,
QWidget#settingsTabPrivacy,
QWidget#settingsTabAppearance,
QWidget#settingsTabPasswords,
QWidget#settingsTabUsers,
QWidget#settingsTabAdvanced,
QWidget#settingsTabUpdates {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #191d2b, stop: 0.48 #141923,
                                stop: 1 #171b27);
}

QWidget#settingsIntro {
    background: transparent;
}

QLabel#settingsPageTitle {
    color: #f2f4f8;
    font-size: 25px;
    font-weight: 700;
}

QLabel#settingsPageDescription,
QLabel#settingsHelpText,
QLabel#usersHint,
QLabel#updatesHint,
QLabel#vaultHint,
QLabel#httpsHint,
QLabel#permissionsLabel {
    color: #98a2b2;
    font-size: 12px;
}

QWidget#settingsCard {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #222838, stop: 0.55 #1c222e,
                                stop: 1 #1a202b);
    border: 1px solid #343d4d;
    border-radius: 17px;
}

QLabel#settingsSectionTitle {
    color: #e9edf4;
    font-size: 14px;
    font-weight: 650;
}

QLabel#searchEngineSummary {
    color: #b7b0f4;
    font-size: 12px;
    padding-top: 2px;
}

QLabel#searchPreviewTitle {
    color: #c9cfda;
    font-size: 12px;
    font-weight: 600;
    padding-top: 3px;
}

QLabel#searchPreviewLabel {
    background: #141820;
    border: 1px solid #292f3b;
    border-radius: 9px;
    color: #aab4c3;
    font-family: monospace;
    font-size: 11px;
    padding: 9px 11px;
}

QLabel#searchPreviewLabel[previewValid="true"] {
    color: #c4d7f0;
    border-color: #303d4e;
}

QLabel#searchPreviewLabel[previewValid="false"] {
    color: #c8ae77;
    border-color: #4a3c27;
}

QComboBox#engineCombo,
QLineEdit#customTemplateEdit {
    min-height: 22px;
    border-radius: 10px;
    padding: 8px 12px;
}

QWidget#settingsActionBar {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #191e2a, stop: 0.5 #141923,
                                stop: 1 #191e2a);
    border-top: 1px solid #303747;
}

QPushButton#settingsResetButton,
QPushButton#settingsSaveButton {
    min-height: 34px;
    border-radius: 11px;
    font-weight: 650;
}

QPushButton#settingsResetButton {
    min-width: 76px;
    background: #252b38;
    border-color: #3a4353;
}

QPushButton#settingsSaveButton {
    min-width: 88px;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 @ACCENT_HI@, stop: 1 @ACCENT@);
    border: 1px solid @ACCENT_HI@;
}

QLabel#settingsStatusLabel {
    color: #98a2b2;
    font-size: 12px;
}

QLabel#updateVersionLabel {
    color: #f1f3f7;
    font-size: 15px;
    font-weight: 600;
}

/* --- scrollbars --------------------------------------------------------- */
QAbstractScrollArea::corner {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #333845;
    min-height: 32px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #454b5b;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #333845;
    min-width: 32px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #454b5b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background: transparent;
    border: none;
    height: 0px;
    width: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}
